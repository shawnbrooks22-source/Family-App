{
  "expo": {
    "name": "Kindo",
    "slug": "kindo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "description": "Kindo helps families manage kids' chores and rewards. Assign quests, track progress, and pay real money — all in one place.",
    "privacyPolicyUrl": "https://kindo.app/privacy",
    "scheme": "kindo",
    "splash": {
      "backgroundColor": "#7C3AED"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kindo.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Kindo notifies you when quests are completed or approved.",
        "NSCameraUsageDescription": "Take a photo to prove your quest is done.",
        "NSPhotoLibraryUsageDescription": "Choose a photo from your library to prove your quest is done.",
        "NSFaceIDUsageDescription": "Use Face ID to unlock the Parent Zone quickly.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED"
      },
      "package": "com.kindo.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "com.android.vending.BILLING"
      ]
    },
    "web": {},
    "plugins": [
      "react-native-iap",
      [
        "expo-notifications",
        {
          "color": "#7C3AED",
          "defaultChannel": "default"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kindo uses your photos to attach proof to completed quests.",
          "cameraPermission": "Kindo uses the camera to take a photo proving a quest is done."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "YOUR_SENTRY_ORG",
          "project": "kindo"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
