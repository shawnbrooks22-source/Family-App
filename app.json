{
  "expo": {
    "name": "Kindo",
    "slug": "kindo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "description": "Kindo helps families manage kids' chores and rewards. Assign quests, track progress, and pay real money — all in one place.",
    "scheme": "kindo",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#7C3AED"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shawnbrooks.kindo",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Kindo notifies you when quests are completed or approved.",
        "NSCameraUsageDescription": "Take a photo to prove your quest is done.",
        "NSPhotoLibraryUsageDescription": "Choose a photo from your library to prove your quest is done.",
        "NSFaceIDUsageDescription": "Use Face ID to unlock the Parent Zone quickly.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7C3AED"
      },
      "package": "com.shawnbrooks.kindo",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "com.android.vending.BILLING",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {},
    "plugins": [
      "./plugins/with-rct-folly",
      "react-native-iap",
      [
        "expo-notifications",
        {
          "color": "#7C3AED",
          "defaultChannel": "default"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kindo uses your photos to attach proof to completed quests.",
          "cameraPermission": "Kindo uses the camera to take a photo proving a quest is done."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4efaab0a-a411-4528-a7b1-b83160f7ac1f"
      }
    }
  }
}
