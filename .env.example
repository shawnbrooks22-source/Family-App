# ─── Kindo Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# ─── Supabase (required for multi-device sync) ────────────────────────────────
# Get from: https://supabase.com → Your Project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON=YOUR_SUPABASE_ANON_KEY

# ─── Claude AI (optional — enables AI quest suggestions) ─────────────────────
# Get from: https://console.anthropic.com
# For production, use the Edge Function proxy instead (set EXPO_PUBLIC_SUPABASE_CLAUDE_PROXY).
EXPO_PUBLIC_CLAUDE_API_KEY=YOUR_ANTHROPIC_API_KEY

# ─── Claude AI Proxy (recommended for production) ─────────────────────────────
# Deploy supabase/functions/claude-proxy and paste the URL here.
# When set, the app calls the proxy instead of the API directly.
EXPO_PUBLIC_SUPABASE_CLAUDE_PROXY=https://YOUR_PROJECT_ID.supabase.co/functions/v1/claude-proxy

# ─── Stripe Payments (optional — enables real money rewards for kids) ─────────
# Sign up at https://stripe.com and get your keys from the Dashboard → Developers
# Publishable key goes in the app; secret key stays on the server (Edge Function secrets).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY

# Deploy supabase/functions/stripe-setup and stripe-charge, then paste URLs here:
EXPO_PUBLIC_SUPABASE_STRIPE_SETUP=https://YOUR_PROJECT_ID.supabase.co/functions/v1/stripe-setup
EXPO_PUBLIC_SUPABASE_STRIPE_CHARGE=https://YOUR_PROJECT_ID.supabase.co/functions/v1/stripe-charge
EXPO_PUBLIC_SUPABASE_DELETE_ACCOUNT=https://YOUR_PROJECT_ID.supabase.co/functions/v1/delete-account

# ─── Sentry (optional — crash reporting) ──────────────────────────────────────
# Sign up at https://sentry.io → Create project → React Native → get DSN
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_KEY@YOUR_ORG.ingest.sentry.io/YOUR_PROJECT_ID
