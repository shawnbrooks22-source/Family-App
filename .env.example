# ─── Kindo Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# ─── Supabase (required for multi-device sync) ────────────────────────────────
# Get from: https://supabase.com → Your Project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON=YOUR_SUPABASE_ANON_KEY

# ─── Claude AI (optional — enables AI quest suggestions) ─────────────────────
# Get from: https://console.anthropic.com
# For production, call the API from a backend (Supabase Edge Function) instead
# of setting this key here to avoid exposing it in the app binary.
EXPO_PUBLIC_CLAUDE_API_KEY=YOUR_ANTHROPIC_API_KEY
